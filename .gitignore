*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.webm

# ============================================================
# Model weights - KEEP by default (user choice)
# sam_b.pt is excluded: 357MB, exceeds GitHub 100MB file limit
# Download from: https://dl.fbaipublicfiles.com/segment_anything/sam_vit_b_01ec64.pth
# ============================================================
dtc_counting/sam_b.pt
# To also exclude YOLO weights, uncomment:
# *.pt
# *.pth
# *.weights
# *.onnx

