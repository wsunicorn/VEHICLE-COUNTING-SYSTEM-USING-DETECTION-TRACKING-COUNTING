.env.*
!.env.example
*.secret
secrets.json

# ============================================================
# Dataset - AIC21 videos & annotations (large files)
# ============================================================
dtc_counting/data/*
# Keep small camera config/sample files that are needed for reproducible demos.
!dtc_counting/data/AIC21_Track1_Vehicle_Counting/
dtc_counting/data/AIC21_Track1_Vehicle_Counting/*
!dtc_counting/data/AIC21_Track1_Vehicle_Counting/ROIs/
dtc_counting/data/AIC21_Track1_Vehicle_Counting/ROIs/*
!dtc_counting/data/AIC21_Track1_Vehicle_Counting/ROIs/cam_5.txt
!dtc_counting/data/AIC21_Track1_Vehicle_Counting/MOI_vectors/
dtc_counting/data/AIC21_Track1_Vehicle_Counting/MOI_vectors/*
!dtc_counting/data/AIC21_Track1_Vehicle_Counting/MOI_vectors/cam_5.txt
!dtc_counting/data/AIC21_Track1_Vehicle_Counting/movement_description/
dtc_counting/data/AIC21_Track1_Vehicle_Counting/movement_description/*
!dtc_counting/data/AIC21_Track1_Vehicle_Counting/movement_description/cam_5.txt
!dtc_counting/data/AIC21_Track1_Vehicle_Counting/counting_gt_sample/
